#!/usr/bin/env bash
# The gate: lint + typecheck + tests for Python and web. Must pass before any commit.
set -euo pipefail
cd "$(dirname "$0")"

echo "== python: ruff"
uv run ruff check .
uv run ruff format --check .
echo "== python: mypy"
uv run mypy
echo "== python: pytest"
uv run pytest -q

echo "== web: eslint"
pnpm -C web lint
echo "== web: tsc"
pnpm -C web typecheck
echo "== web: playwright"
pnpm -C web e2e

echo "== check passed"
